---
import { getCollection } from "astro:content";
import articles from "../data/articles.json";
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/jetbrains-mono";
import "../styles/wiki.css";

export async function getStaticPaths() { return [{ params: { slug: "all" } }]; }

const CATS = [
  ["guide", "DSH を使う"],
  ["subsystems", "サブシステム"],
  ["config", "設定の詳細"],
  ["cli", "CLI リファレンス"],
  ["reference", "リファレンス"],
  ["rdsh", "rustdsh"],
  ["rdsh-cmd", "rustdsh コマンド"],
  ["rdsh-src", "rustdsh ソース読解"],
  ["rdsh-dw", "rustdsh 調査"],
  ["rdsh-dw2", "rustdsh 運用"],
  ["develop", "開発ガイド"],
  ["develop2", "レビュー"],
  ["deep", "深掘り"],
  ["deep2", "深掘り 2"],
  ["ug", "移行"],
  ["meta", "メタ"],
] as const;
const groups = CATS.map(([key, label]) => ({
  key, label,
  items: articles.filter((a) => a.cat === key).sort((a, b) => a.title.localeCompare(b.title, "ja")),
})).filter((g) => g.items.length > 0);
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>全記事 — DSH 日本語Wiki</title>
  <script is:inline>
    (() => {
      const s = localStorage.getItem("dsh-theme");
      const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    })();
  </script>
</head>
<body>
  <div class="shell">
    <header class="site">
      <a class="logo" href="/">DSH 日本語Wiki</a>
      <span style="flex:1"></span>
      <div class="header-right">
        <a href="/">メインページ</a>
        <button type="button" id="theme-btn">◐ テーマ</button>
      </div>
    </header>
    <nav class="tabs" aria-label="表示">
      <a href="/">閲覧</a>
      <a class="on" href="/all">全記事</a>
    </nav>

    <article>
      <h1 class="article">全記事（{articles.length}）</h1>
      <p class="meta"><span>分類ごとの一覧です。文字は各記事の分量です。</span></p>
      {groups.map((g) => (
        <section>
          <h2 class="cat-h">{g.label} <span>（{g.items.length}）</span></h2>
          <ul class="doccols">
            {g.items.sort((a, b) => a.title.localeCompare(b.title, "ja")).map((a) => (
              <li><a href={"/" + a.slug}>{a.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </article>

    <footer class="sitedone">
      本Wikiは非公式です · 内容は MIT · <a href="/">メインページ</a>
    </footer>
  </div>

  <script>
    document.getElementById("theme-btn")?.addEventListener("click", () => {
      const cur = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("dsh-theme", next);
    });
  </script>
</body>
</html>
