---
import { getCollection, render } from "astro:content";
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/jetbrains-mono";
import "../styles/wiki.css";

export async function getStaticPaths() {
  const all = await getCollection("articles");
  const sorted = [...all].sort((a, b) => a.data.slug.localeCompare(b.data.slug));
  return sorted.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1].data : null,
      next: i < sorted.length - 1 ? sorted[i + 1].data : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3).slice(0, 14);
const fmt = (n: number) => n.toLocaleString("ja-JP");
const today = new Date().toISOString().slice(0, 10);
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{d.title} — DSH 日本語Wiki</title>
  <script is:inline>
    (() => {
      const s = localStorage.getItem("dsh-theme");
      const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    })();
  </script>
</head>
<body>
  <div class="shell">
    <header class="site">
      <a class="logo" href="/">DSH 日本語Wiki</a>
      <span style="flex:1"></span>
      <div class="header-right">
        <a href="/all">全記事</a>
        <button type="button" id="theme-btn">◐ テーマ</button>
      </div>
    </header>
    <nav class="tabs" aria-label="表示">
      <a class="on" href="/">閲覧</a>
      <a href="/all">全記事</a>
      <a href="https://github.com/jimoto-no-llm/dsh-wiki" rel="noopener">ソース</a>
    </nav>

    <article>
      <h1 class="article">{d.title}</h1>
      <p class="meta">
        <span class="num">{fmt(d.chars)} 字</span>
        <span>·</span>
        <span>{d.catLabel}</span>
        <span>·</span>
        <span>最終更新 {today}</span>
      </p>

      {toc.length > 1 && (
        <div class="toc">
          <div class="h">目次</div>
          <ol>
            {toc.map((h) => (
              <li style={h.depth === 3 ? "margin-left:1.2rem" : ""}>
                <a href={"#" + h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </div>
      )}

      <div class="prose">
        <Content />
      </div>
    </article>

    <nav class="pagenav">
      {prev ? (
        <a href={"/" + prev.slug}>
          <span class="lbl">前の記事</span>
          <span>{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={"/" + next.slug}>
          <span class="lbl">次の記事</span>
          <span>{next.title}</span>
        </a>
      ) : <span />}
    </nav>

    <footer class="sitedone">
      本Wikiは非公式です · 内容は MIT · <a href="/">メインページへ戻る</a> · <a href="/all">全記事</a>
    </footer>
  </div>

  <script>
    document.getElementById("theme-btn")?.addEventListener("click", () => {
      const cur = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("dsh-theme", next);
    });
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        window.location.href = "/all";
      }
    });
  </script>
</body>
</html>
