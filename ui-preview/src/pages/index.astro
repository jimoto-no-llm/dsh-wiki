---
import Search from "../components/Search.tsx";
import articles from "../data/articles.json";
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/jetbrains-mono";
import "../styles/wiki.css";

const BASE = "http://127.0.0.1:4400/"; // 未使用（リンクは全部 /slug）

const bySlug = (s: string) => articles.find((a) => a.slug === s);
const picks = [
  "guide/getting-started",
  "guide/profiles",
  "rdsh/overview",
  "subsystems/approval",
  "deep/cordis-primer",
  "reference/faq",
].map(bySlug).filter(Boolean);

const CATS = [
  ["guide", "DSH を使う"],
  ["subsystems", "サブシステム"],
  ["config", "設定の詳細"],
  ["cli", "CLI リファレンス"],
  ["reference", "リファレンス"],
  ["rdsh", "rustdsh"],
  ["rdsh-cmd", "rustdsh コマンド"],
  ["rdsh-src", "rustdsh ソース読解"],
  ["rdsh-dw", "rustdsh 調査"],
  ["rdsh-dw2", "rustdsh 運用"],
  ["develop", "開発ガイド"],
  ["develop2", "レビュー"],
  ["deep", "深掘り"],
  ["deep2", "深掘り 2"],
  ["ug", "移行"],
  ["meta", "メタ"],
] as const;
const groups = CATS.map(([key, label]) => ({
  key, label,
  items: articles.filter((a) => a.cat === key).sort((a, b) => a.title.localeCompare(b.title, "ja")),
})).filter((g) => g.items.length > 0);
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DSH 日本語Wiki</title>
  <script is:inline>
    (() => {
      const s = localStorage.getItem("dsh-theme");
      const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    })();
  </script>
</head>
<body>
  <div class="shell">
    <header class="site">
      <a class="logo" href="/">DSH 日本語Wiki</a>
      <div class="searchbox">
        <Search client:load />
      </div>
      <div class="header-right">
        <a href="/all">全記事</a>
        <button type="button" id="theme-btn">◐ テーマ</button>
      </div>
    </header>
    <nav class="tabs" aria-label="表示">
      <a class="on" href="/">閲覧</a>
      <a href="/w/">匿名編集Wiki</a>
      <a href="/all">全記事</a>
      <a href="https://github.com/jimoto-no-llm/dsh-wiki" rel="noopener">ソース</a>
      <a href="https://github.com/jimoto-no-llm/dsh-wiki/issues" rel="noopener">フィードバック</a>
    </nav>

    <article>
      <h1 class="article">DSH 日本語Wiki</h1>
      <p class="meta">
        <span>{articles.length} 記事</span>
        <span>·</span>
        <span>最終更新 {new Date().toISOString().slice(0,10)}</span>
      </p>

      <div class="prose">
        <p>
          <b>DSH 日本語Wiki</b>は、DeepSeek Harness（<a href="https://github.com/deepseek-ai/deepseek-harness" rel="noopener">deepseek-harness</a>）と <a href="https://github.com/jimoto-no-llm/rustdsh" rel="noopener">rustdsh</a> を日本語で解説する<b>非公式</b>ドキュメントです。
          編集にアカウントは不要で、保存するとすぐ公開されます。各記事は上流のソースに基づき、末尾に<b>出典</b>を置いています。
        </p>
        <p>
          はじめての場合は、下の「まず読む」を上からお読みください。DSH の使い方から、rustdsh の内部まで一通り分かります。
        </p>
        <p>
          <a href="/w/"><b>匿名編集Wiki（/w/）</b></a>では、どのページもその場で編集できます。各記事の「このページを編集」からどうぞ。
        </p>
      </div>

      <section>
        <h2 class="cat-h" style="font-size:1.05rem;border-bottom:1px solid var(--line);padding-bottom:0.3rem;">まず読む</h2>
        <ul class="readlist">
          {picks.map((p) => (
            <li>
              <a href={"/" + p!.slug}>
                <span>{p!.title}</span>
                <span class="d">{p!.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {groups.map((g) => (
        <section>
          <h2 class="cat-h">{g.label} <span>（{g.items.length}）</span></h2>
          <ul class="toccols">
            {g.items.map((a) => (
              <li><a href={"/" + a.slug}>{a.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </article>

    <footer class="sitedone">
      事実は条件つきで書く · 出典を残す · 本Wikiは非公式（プロジェクト名に「DeepSeek Harness」は使わない）<br />
      コンテンツは MIT · デザインは <a href="https://github.com/heydamir/unslop">unslop</a> by @heydamir（CC BY 4.0）を参照 · ソースは <a href="https://github.com/jimoto-no-llm/dsh-wiki">GitHub</a>
    </footer>
  </div>

  <script>
    document.getElementById("theme-btn")?.addEventListener("click", () => {
      const cur = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("dsh-theme", next);
    });
  </script>
</body>
</html>