---
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/jetbrains-mono";
import PageTable from "../components/PageTable.tsx";
import SearchBox from "../components/SearchBox.tsx";
import "../styles/ui.css";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DSH 日本語Wiki — UIプレビュー</title>
</head>
<body>
  <header class="topbar">
    <a class="logo" href="#">DSH 日本語Wiki</a>
    <nav>
      <a href="#">最近の編集</a>
      <a href="#">ページを編集</a>
    </nav>
  </header>

  <section class="search-hero">
    <div class="wiki-mark"><b>DSH</b> 日本語Wiki</div>
    <p class="lead">
      DeepSeek Harness（DSH）と rustdsh の非公式ドキュメント。<br />アカウント不要で、保存するとすぐ公開されます。
    </p>
    <SearchBox client:load />
    <p class="hint">まず読むなら <a href="#">「はじめに」</a>　·　新しいページは <a href="#">作成フォーム</a> から</p>
  </section>

  <section style="margin-top:24px">
    <h2 style="font-size:15px; font-weight:500; margin:0 0 12px">このWikiの記事</h2>
    <PageTable client:load />
  </section>

  <footer>
    事実は条件つきで書く · 出典を残す · 非公式（プロジェクト名に「DeepSeek Harness」は使わない） · <a href="#">ルールと編集のしかた</a> · MIT · unslop guidance by @heydamir (CC BY 4.0)
  </footer>
</body>
</html>
