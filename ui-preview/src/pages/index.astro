---
import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/jetbrains-mono";
import PageTable from "../components/PageTable.tsx";
import SearchBox from "../components/SearchBox.tsx";
import "../styles/ui.css";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DSH 日本語Wiki — UIプレビュー</title>
</head>
<body>
  <header class="topbar">
    <a class="logo" href="#">DSH 日本語Wiki<span>ローカルプレビュー</span></a>
    <nav>
      <a href="#">はじめに</a>
      <a href="#">rustdsh とは</a>
      <a href="#">最近の編集</a>
      <a href="#">ページを編集</a>
    </nav>
  </header>

  <section class="search-hero">
    <div class="wiki-mark"><b>DSH</b> 日本語Wiki</div>
    <p class="lead">
      DeepSeek Harness（DSH）と rustdsh の非公式ドキュメント。<br />アカウント不要で、保存するとすぐ公開されます。
    </p>
    <SearchBox client:load />
    <p class="hint">まず読むなら <a href="#">「はじめに」</a>　·　新しいページは <a href="#">作成フォーム</a> から</p>
  </section>

  <section style="margin-top:24px">
    <h2 style="font-size:15px; font-weight:500; margin:0 0 12px">このWikiの記事</h2>
    <PageTable client:load />
  </section>

  <div class="two-col">
    <div class="box">
      <h2>新しいページを作る</h2>
      <div class="create">
        <input type="text" placeholder="ページ名（日本語OK）" aria-label="新しいページ名" />
        <button>作成する</button>
      </div>
      <p class="muted">保存すると即公開。履歴が残るのでどこからでも戻せます。</p>
    </div>
    <div class="box">
      <h2>ルール</h2>
      <ul>
        <li>事実は条件つきで書く（計測値には環境を添える）</li>
        <li>末尾に出典を1行以上残す</li>
        <li>本Wikiは非公式。プロジェクト名に「DeepSeek Harness」は使わない</li>
      </ul>
    </div>
  </div>

  <footer>
    デザイン確認用のローカルプレビュー（Astro + TanStack Table, unslop passes適用） · 実サイト: dsh.sahen.site · 非公式 · MIT
    <br />unslop guidance by @heydamir (CC BY 4.0)
  </footer>
</body>
</html>
